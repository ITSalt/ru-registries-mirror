[Unit]
Description=Ежедневное обновление зеркала государственных реестров

[Timer]
# Реестр иноагентов пополняется по пятницам, но точное время не гарантировано,
# поэтому снимаем ежедневно. Лишние прогоны бесплатны: файл переписывается
# только при изменении содержимого.
OnCalendar=*-*-* 04:17:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
